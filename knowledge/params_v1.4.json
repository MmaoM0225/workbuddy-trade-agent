  "parent": "v1.3",
  "changelog": [
    "用户要求保证持仓多样性：新增 min_holdings=8 / max_holdings=12 硬约束",
    "权重分配改为池内归一化 weight_i = regime_base × qs_i / Σqs（原 target=regime_base×qs/100 必然超过 15% 单票上限，导致组合只剩 3-4 只）",
    "新增 min_single_weight_pct=3，避免归一化后出现碎片化小仓位",
    "订单不再写金额字段：金额由持仓管家在执行时按当日实际总资产（现金+持仓市值）× 权重百分比计算，股数按 100 股整数倍取整"
  ],
  "weight_allocation": {
    "method": "quality_normalized",
    "formula": "weight_i = regime_base_position_pct × qs_i / Σ(qs_j for j in selected N)",
    "selection": "按 quality_score 降序取 N 只，N 由 min_holdings/max_holdings 与行业分散度决定，默认 10",
    "clamp": "单票权重 clamp 到 [min_single_weight_pct, max_single_weight_pct]，clamp 后重新归一化一次",
    "sector_constraint": "单行业合计 ≤ max_sector_weight_pct(30)，超限时按 quality_score 从低到高剔除并补入次优标的",
    "amount_rule": "订单只给权重百分比，金额与股数由持仓管家执行时按实际总资产计算"
  }
}