        "valuation": ["ep_ttm", "bp_ttm", "sp_ttm"],
        "liquidity": ["turnover_rate"]
      }
    },
    "factors": {
      "mom_5d": {"weight": 0.06, "direction": "desc", "group": "momentum", "source": "tushare daily 5 日收盘价"},
